{
  "name": "pwned",
  "version": "13.1.2",
  "private": false,
  "description": "A command-line tool for querying the 'Have I been pwned?' service.",
  "keywords": [
    "breach",
    "dump",
    "hack",
    "haveibeenpwned",
    "hibp",
    "passwords",
    "pastes",
    "pwned",
    "security"
  ],
  "homepage": "https://wkovacs64.github.io/pwned",
  "bugs": {
    "url": "https://github.com/wKovacs64/pwned/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wKovacs64/pwned.git"
  },
  "bin": "bin/pwned.js",
  "directories": {
    "lib": "./lib",
    "bin": "./bin"
  },
  "files": [
    "bin",
    "lib"
  ],
  "type": "module",
  "main": "bin/pwned.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install",
    "changeset:publish": "changeset publish",
    "typecheck": "tsc",
    "clean": "del-cli lib coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "prebuild": "pnpm run --silent clean",
    "prepublishOnly": "run-p --silent lint typecheck test build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "common-tags": "^1.8.2",
    "conf": "^15.0.2",
    "hibp": "^15.2.0",
    "ora": "^9.0.0",
    "prettyjson": "^1.2.5",
    "source-map-support": "^0.5.21",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@types/common-tags": "1.8.4",
    "@types/debug": "4.1.13",
    "@types/node": "24.13.3",
    "@types/prettyjson": "0.0.33",
    "@types/ws": "8.18.1",
    "@types/yargs": "17.0.35",
    "@vitest/coverage-v8": "4.1.11",
    "@wkovacs64/oxlint-config": "0.2.1",
    "cross-env": "10.1.0",
    "del-cli": "7.0.0",
    "msw": "2.15.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "type-fest": "5.8.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.24.0"
}
